\newcommand{\toneC}[1]{\textcolor{tone3}{#1}}
\newcommand{\toneD}[1]{\textcolor{tone4}{#1}}
\newcommand{\toneE}[1]{\textcolor{tone5}{#1}}

% Names of things (programs, files, folders, hosts) in sans; \texttt only for literal text
% The sans underscore is a third wider than a letter; inside \name it is as wide as a space
% (stroke: the stem of l, 0.075 em; height: the font's own underscore, from -0.164 em)
\newcommand{\name@us}{\leavevmode\rule[-0.164em]{\fontdimen2\font}{0.075em}}
% No TeX ligatures in a name: -- stays two dashes, as in -Users-atcold--settings
\newcommand{\name}[1]{\textsf{\addfontfeatures{Ligatures=TeXOff}\let\_\name@us#1}}
% A name that is a link (ls -F marks it @): grey and underlined, inside \name
\newcommand{\lk}[1]{{\color{black!50}\underline{#1}}}
\newcommand{\emo}[1]{\texttwemoji{#1}}

% Links, URLs and citations in one strong cyan: hyperref's default green barely shows on a white
% screen, and blue reads as black text.
\definecolor{link}{HTML}{0099CC}
\AtBeginDocument{\@ifpackageloaded{hyperref}{%
  \hypersetup{linkcolor=link, urlcolor=link, filecolor=link, citecolor=link}}{}}

% Code listings
\lstdefinestyle{shell}{
  language=bash, moredelim=[is][\color{red!85!black}]{|!}{!|},
  moredelim=[is][\color{black!40}]{|~}{~|}, basicstyle=\ttfamily\footnotesize, columns=flexible,  % flexible keeps trailing comments aligned
  keepspaces=true, breaklines=true, breakatwhitespace=false, showstringspaces=false,
  keywordstyle=\color{violet!80!black}, stringstyle=\color{green!40!black},  % no bold: bold mono swaps in a narrower font
  commentstyle=\color{black!40}\itshape,
  morekeywords={ssh,scp,curl,chmod,echo,cd,clear,sudo,brew,gs,lp,lpstat,lpoptions,lpinfo,cupsctl,cupsfilter,grep,ls,find,tail,head,strings,file,identify,tmux,killall,launchctl,cancel,mdfind,sed,xxd,stat,which,type,pmset,open,rm,tr,wc,cut,cat,sleep,tailscale,kasa,nc,printf,pipx},
  literate={×}{{$\times$}}1 {→}{{$\rightarrow$}}1
}
\lstdefinestyle{out}{
  basicstyle=\ttfamily\scriptsize\color{black!80}, columns=fullflexible, keepspaces=true,
  breaklines=true, breakatwhitespace=false, showstringspaces=false,
  % Invisible markers around recorded output: |!…!| the line to read, |~…~| noise to skip
  moredelim=[is][\color{red!80!black}]{|!}{!|},  % colour only: bold mono swaps in a narrower font
  moredelim=[is][\color{black!35}]{|~}{~|},
  literate={×}{{$\times$}}1 {→}{{$\rightarrow$}}1
}
\lstdefinestyle{python}{
  language=Python, basicstyle=\ttfamily\footnotesize, columns=fullflexible, keepspaces=true,
  breaklines=true, showstringspaces=false,
  keywordstyle=\color{violet!80!black}, stringstyle=\color{green!40!black},
  commentstyle=\color{black!40}\itshape, literate={×}{{$\times$}}1
}

% Config-file listings riding on out: keys take colour, values stay plain.
% Bare TOML keys are listings keywords, protected inside values by string lexing.
% JSON keys are literate patterns (listings matches them ahead of its lexers, where
% otherkeywords would fight the quote as a string delimiter); the trailing colon is
% part of each pattern, so a value repeating a key's word stays plain. Patterns that
% share a prefix list the longer first, since the first match in the list wins.
% References: LaTeX's own list, label column included, in a smaller font and two columns
\RequirePackage{multicol}
\renewenvironment{thebibliography}[1]{%
  \footnotesize\section*{\refname}%
  \begin{multicols}{2}%
  \list{\@biblabel{\@arabic\c@enumiv}}{\settowidth\labelwidth{\@biblabel{#1}}%
     \leftmargin\labelwidth \advance\leftmargin\labelsep \@openbib@code
     \usecounter{enumiv}\let\p@enumiv\@empty \renewcommand\theenumiv{\@arabic\c@enumiv}}%
  \sloppy \clubpenalty4000 \@clubpenalty\clubpenalty \widowpenalty10000%
  \sfcode`\.\@m}%
  {\endlist\end{multicols}}

% A concept explained
\newtcolorbox{insight}[1]{enhanced, breakable, colback=blue!18, colframe=blue!60!black,
  colbacktitle=blue!60, coltitle=black, title={\emo{light bulb}\ #1}, fonttitle=\bfseries, boxrule=0.8pt, arc=2pt}

% A command run in the shared tmux pane; each lesson sets \panetitle to say where
\newcommand{\panetitle}{Shared pane (visible to you)}
\newtcblisting{pane}{listing engine=listings, listing only, enhanced, breakable,
  colback=blue!12, colframe=blue!70!black, boxrule=0.6pt, arc=2pt,
  colbacktitle=blue!60, coltitle=black, title={\emo{desktop computer}\ \panetitle}, fonttitle=\small\bfseries,
  listing options={style=shell}}

% What a command printed
\newtcblisting{cmdout}{listing engine=listings, listing only, enhanced, breakable,
  colback=white, colframe=black!25, boxrule=0.4pt, arc=1pt, left=4pt,
  title={Output}, fonttitle=\scriptsize, coltitle=black!70, colbacktitle=black!6,
  listing options={style=out}}
