% Revision line in the title page's header, and no page numbers (a cropping reader then joins
% pages without a gap), and a revision table for the end (\revisiontable).
% style/revision.pl writes \jobname.rev from git at build time; a document without it (outside a
% repo) keeps its plain pages and an empty table.
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\newcommand{\alfdoc@revision}[4]{\gdef\alfdoc@revnum{#1}%
  \gdef\revisionline{Revision #1\ifnum#4=1\ draft\fi\ \textperiodcentered\ #2%
    \if\relax\detokenize{#3}\relax\else\ \textperiodcentered\ \ifnum#4=1 after \fi\texttt{#3}\fi}}
\newcommand{\revisionline}{}
\newcommand{\alfdoc@rows}{}
% Review: “Do we want to repeat all identical values? Maybe they can also go 25% grey.”
\newcommand{\alfdoc@same}[1]{\textcolor{black!25}{#1}}  % a date part repeating the row above, and the hash
\newcommand{\alfdoc@revrow}[4]{\g@addto@macro\alfdoc@rows{#1 & #2 & \alfdoc@hash{#3} & #4\\}}
\newcommand{\alfdoc@commiturl}[2]{\global\@namedef{alfdoc@url@#1}{#2}}
% A hash links to its diff on GitHub when the repo lives there and hyperref is loaded
% (a quiet cyan, so it still looks like a link), and is grey otherwise.
% Review: “It's not something I'm going to read. So grey it should go.”
\newcommand{\alfdoc@hash}[1]{\@ifundefined{alfdoc@url@#1}{\alfdoc@same{\texttt{#1}}}%
  {\@ifundefined{href}{\alfdoc@same{\texttt{#1}}}%
    {{\hypersetup{urlcolor=link!45}\href{\@nameuse{alfdoc@url@#1}}{\texttt{#1}}}}}}
% Review: “That header should show on the first page only, since my reader cuts out the white space.”
% Review: “I think the same holds for the page number. I don't find any usage to that.”
% Review: “It shouldn't be too distracting.” (25% grey, script size)
\InputIfFileExists{\jobname.rev}{%
  \RequirePackage{fancyhdr}
  \fancypagestyle{plain}{\fancyhf{}
    \fancyhead[R]{\scriptsize\color{black!25}\revisionline}
    \renewcommand{\headrulewidth}{0pt}}
  \AtBeginDocument{\pagestyle{empty}\thispagestyle{plain}}}{}  % the first page, with or without \maketitle
% Review: “The dates in the table are all misaligned.” (weekday, day, month: three columns)
\newcommand{\revisiontable}{\section*{Revisions}
  {\footnotesize\begin{tabularx}{\textwidth}{@{}r c@{~}r@{~}c l >{\raggedright\arraybackslash}X@{}}
    \toprule & \multicolumn{3}{l}{Date} & Commit & Change\\ \midrule \alfdoc@rows \bottomrule
  \end{tabularx}\par}}  % full text width: the Change column takes the rest

% This revision's changes, one item per numbered hand, in the same order: a box under the title,
% filled from the hands' long notes. It appears by itself after \maketitle while \reviewtrue and
% there is at least one hand.
\newtcolorbox{alfdoc@changesbox}{enhanced jigsaw, opacityback=0, colframe=red!85!black, boxrule=0.6pt, arc=2pt,
  opacitybacktitle=0, coltitle=red!85!black, fonttitle=\small\bfseries,
  title={\@ifundefined{alfdoc@revnum}{Changes}{Changes in revision \alfdoc@revnum}}}
\newcommand{\alfdoc@changes}{\ifreview\ifx\alfdoc@changelist\@empty\else
  \begin{alfdoc@changesbox}\small
  \begin{list}{\textbf{\color{red!85!black}\arabic{enumi}}}{\usecounter{enumi}%
    \setlength{\leftmargin}{1.5em}\setlength{\itemsep}{0pt}\setlength{\topsep}{0pt}}
  \alfdoc@changelist
  \end{list}\smallskip
  Earlier revisions are in the table at the end, and each round's details in the project note's log.
  \end{alfdoc@changesbox}\fi\fi}
\AddToHook{cmd/maketitle/after}{\alfdoc@changes}

% Diff marks: + added, ± edited, − removed, in the left margin level with the line, each with an
% optional tiny note. One mark per kind of edit, not one per change.
\newcommand{\diff@mark}[3]{\ifreview\tikz[remember picture,overlay,baseline]{
  \node[anchor=east, inner sep=0pt, font=\bfseries\color{#1}] (diff@m)
    at ([xshift=1.95cm]current page.west |- 0,0.3em) {\ensuremath{#2}};
  \if\relax\detokenize{#3}\relax\else
    \node[anchor=north east, inner sep=0pt, text width=1.7cm, align=right,
      font=\tiny\itshape\color{#1}] at ([yshift=-1.5pt]diff@m.south east) {#3};
  \fi}\fi}
\newcommand{\diff@put}[3]{%
  \ifvmode\leavevmode\let\here@next\ignorespaces
  \else\ifdim\lastskip>\z@\let\here@next\ignorespaces\else\let\here@next\xspace\fi\fi
  \diff@mark{#1}{#2}{#3}\here@next}
\newcommand{\added}[1][]{\diff@put{diffadd}{\boldsymbol{+}}{#1}}
% ± in two colours: a green + over a red −
\colorlet{diffadd}{green!55!black}
\colorlet{diffdel}{red!85!black}
\newcommand{\diff@pm}{\ooalign{\raisebox{0.22em}{\color{diffadd}$\boldsymbol{+}$}\cr
  \raisebox{-0.3em}{\color{diffdel}$\boldsymbol{-}$}}}
\newcommand{\edited}[1][]{\diff@put{black}{\diff@pm}{#1}}
% \removed{text}: the removed text, struck out in red, so the reader sees what went
\newcommand{\removed}[2][]{\diff@put{diffdel}{\boldsymbol{-}}{#1}{\color{diffdel}\sout{#2}}}

