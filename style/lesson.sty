% Shared style for every lesson: colours, names, listings, and the boxes all lessons use.
% Lessons find it through their .latexmkrc:  ensure_path('TEXINPUTS', '../style//');
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lesson}

\RequirePackage{xcolor}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{twemojis}
\RequirePackage{tikz}
\RequirePackage{xspace}
\RequirePackage{pgfornament}  % Vectorian ornaments; see `texdoc vectorian` for the numbered list

% Review arrows: a numbered hand in the left margin, level with the line it sits on.
% \reviewfalse hides them all.
\newif\ifreview
\reviewtrue
\newcounter{here}
\newcommand{\here@hand}[1]{\ifreview\refstepcounter{here}\label{here:\thehere}\tikz[remember picture,overlay,baseline]{
  \node[anchor=east, inner sep=0pt, font=\small\bfseries\color{red!85!black}] (here@h)
    at ([xshift=1.95cm]current page.west |- 0,0.3em) {\thehere\,\pgfornament[height=0.9em]{152}};
  \if\relax\detokenize{#1}\relax\else
    \node[anchor=north east, inner sep=0pt, text width=1.7cm, align=right,
      font=\tiny\itshape\color{red!85!black}] at ([yshift=-1.5pt]here@h.south east) {#1};
  \fi}\fi}
% \here[what changed]: the optional note goes under the hand, in tiny italic.
% Keeps the space a control word would swallow (".\here The"), but adds none at a
% paragraph start or after a space ("the \here word").
\newcommand{\here}[1][]{%
  \ifvmode\leavevmode\let\here@next\ignorespaces
  \else\ifdim\lastskip>\z@\let\here@next\ignorespaces\else\let\here@next\xspace\fi\fi
  \here@hand{#1}\here@next}

% ColorBrewer Set3, in order
\definecolor{aqua}{HTML}{8DD3C7}
\definecolor{yellow}{HTML}{FFFFB3}
\definecolor{lavender}{HTML}{BEBADA}
\definecolor{red}{HTML}{FB8072}
\definecolor{blue}{HTML}{80B1D3}
\definecolor{orange}{HTML}{FDB462}
\definecolor{green}{HTML}{B3DE69}
\definecolor{pink}{HTML}{FCCDE5}
\definecolor{grey}{HTML}{D9D9D9}
\definecolor{violet}{HTML}{BC80BD}

% Tone colours for pinyin and characters, as in the dictionary:
% Pleco's hues (1 warm, 2 green, 3 blue, 4 purple, 5 grey), darkened Set3
\definecolor{tone1}{HTML}{D1503F}
\definecolor{tone2}{HTML}{6A9E33}
\definecolor{tone3}{HTML}{3F7FA8}
\definecolor{tone4}{HTML}{8F4F91}
\definecolor{tone5}{HTML}{8A8A8A}
\newcommand{\toneA}[1]{\textcolor{tone1}{#1}}
\newcommand{\toneB}[1]{\textcolor{tone2}{#1}}
\newcommand{\toneC}[1]{\textcolor{tone3}{#1}}
\newcommand{\toneD}[1]{\textcolor{tone4}{#1}}
\newcommand{\toneE}[1]{\textcolor{tone5}{#1}}

% Names of things (programs, files, folders, hosts) in sans; \texttt only for literal text
% The sans underscore is a third wider than a letter; inside \name it is as wide as a space
\newcommand{\name@us}{\leavevmode\rule[-0.2ex]{\fontdimen2\font}{0.045em}}
\newcommand{\name}[1]{\textsf{\let\_\name@us#1}}
\newcommand{\emo}[1]{\texttwemoji{#1}}

% Code listings
\lstdefinestyle{shell}{
  language=bash, basicstyle=\ttfamily\footnotesize, columns=flexible,  % flexible keeps trailing comments aligned
  keepspaces=true, breaklines=true, breakatwhitespace=false, showstringspaces=false,
  keywordstyle=\color{violet!80!black}\bfseries, stringstyle=\color{green!40!black},
  commentstyle=\color{black!40}\itshape,
  morekeywords={ssh,scp,curl,chmod,echo,cd,clear,sudo,brew,gs,lp,lpstat,lpoptions,lpinfo,cupsctl,cupsfilter,grep,ls,find,tail,head,strings,file,identify,tmux,killall,launchctl,cancel,mdfind,sed,xxd,stat,which,type,pmset,open,rm,tr,wc,cut,cat,sleep},
  literate={×}{{$\times$}}1 {→}{{$\rightarrow$}}1
}
\lstdefinestyle{out}{
  basicstyle=\ttfamily\scriptsize\color{black!80}, columns=fullflexible, keepspaces=true,
  breaklines=true, breakatwhitespace=false, showstringspaces=false,
  % Invisible markers around recorded output: |!…!| the line to read, |~…~| noise to skip
  moredelim=[is][\color{red!80!black}\bfseries]{|!}{!|},
  moredelim=[is][\color{black!35}]{|~}{~|},
  literate={×}{{$\times$}}1 {→}{{$\rightarrow$}}1
}
\lstdefinestyle{python}{
  language=Python, basicstyle=\ttfamily\footnotesize, columns=fullflexible, keepspaces=true,
  breaklines=true, showstringspaces=false,
  keywordstyle=\color{violet!80!black}\bfseries, stringstyle=\color{green!40!black},
  commentstyle=\color{black!40}\itshape, literate={×}{{$\times$}}1
}

% A concept explained
\newtcolorbox{insight}[1]{enhanced, breakable, colback=blue!18, colframe=blue!60!black,
  colbacktitle=blue!60, coltitle=black, title={\emo{light bulb}\ #1}, fonttitle=\bfseries, boxrule=0.8pt, arc=2pt}

% A command run in the shared tmux pane; each lesson sets \panetitle to say where
\newcommand{\panetitle}{Shared pane (visible to you)}
\newtcblisting{pane}{listing engine=listings, listing only, enhanced, breakable,
  colback=blue!12, colframe=blue!70!black, boxrule=0.6pt, arc=2pt,
  colbacktitle=blue!60, coltitle=black, title={\emo{desktop computer}\ \panetitle}, fonttitle=\small\bfseries,
  listing options={style=shell}}

% What a command printed
\newtcblisting{cmdout}{listing engine=listings, listing only, enhanced, breakable,
  colback=white, colframe=black!25, boxrule=0.4pt, arc=1pt, left=4pt,
  title={Output}, fonttitle=\scriptsize, coltitle=black!70, colbacktitle=black!6,
  listing options={style=out}}
